# KlickPint — Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 3020)
PORT=3020

# Node environment
NODE_ENV=production

# Admin panel (/admin.html) password. Required for the admin panel to work
# at all — if unset, /api/admin/* returns 503 and the panel stays disabled.
# Pick something long and random; it's the only thing standing between the
# public internet and your activity log (IPs, pin activity).
ADMIN_PASSWORD=

# ── Contact form email (optional) ──────────────────────────────────────────
# Cloudflare Email Routing only receives mail for support@klickpint.online;
# it cannot send. The contact form sends through an SMTP account instead,
# normally the Gmail that the routing forwards to.
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (16 letters) below.
# Without these, messages are still saved to data/contact.jsonl and shown
# in the admin panel, just not emailed.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# Where form messages are delivered. Defaults to SMTP_USER. Leave it unset
# for Gmail: Gmail hides mail it sent to an address (like support@) that
# forwards straight back to the same Gmail account.
# CONTACT_TO=
