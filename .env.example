# KlickPint — Environment Variables
# Copy this file to .env and fill in your values

# Server port (default: 3020)
PORT=3020

# Node environment
NODE_ENV=production

# Admin panel (/admin.html) password. Required for the admin panel to work
# at all — if unset, /api/admin/* returns 503 and the panel stays disabled.
# Pick something long and random; it's the only thing standing between the
# public internet and your activity log (IPs, pin activity).
ADMIN_PASSWORD=
