{
  "name": "klickpint",
  "version": "2.0.0",
  "description": "KlickPint — Free Pinterest Video Downloader",
  "main": "server.js",
  "scripts": {
    "start"      : "node server.js",
    "dev"        : "nodemon server.js",
    "pm2:start"  : "pm2 start ecosystem.config.js --env production",
    "pm2:stop"   : "pm2 stop klickpint",
    "pm2:restart": "pm2 restart klickpint",
    "pm2:logs"   : "pm2 logs klickpint",
    "pm2:status" : "pm2 status"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express"           : "^4.18.2",
    "axios"             : "^1.6.0",
    "cors"              : "^2.8.5",
    "cheerio"           : "^1.0.0-rc.12",
    "express-rate-limit": "^7.1.5",
    "helmet"            : "^7.1.0",
    "compression"       : "^1.7.4",
    "morgan"            : "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
